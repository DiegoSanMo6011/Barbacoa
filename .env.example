# ============================
# SUPABASE CONFIGURATION
# ============================

# URL del proyecto Supabase
SUPABASE_URL=https://rwbzbaenzfqnstxsuxrl.supabase.co

# Clave pública (anon key) para desarrollo
SUPABASE_KEY=PEGA_AQUI_TU_ANON_KEY

# ============================
# APP CONFIGURATION
# ============================

# Nombre de la aplicación
APP_NAME=Barbacoa POS

# Entorno (development / production)
APP_ENV=development

# Escala visual de la interfaz para legibilidad (0.9 a 1.6).
BARBACOA_UI_SCALE=1.1

# Modo de ventana al iniciar: maximized | fullscreen | windowed
BARBACOA_UI_START_MODE=maximized

# Panel de comandas abiertas al iniciar: collapsed | visible
BARBACOA_UI_OPEN_COMANDAS=collapsed

# ============================
# AUTH CONFIGURATION
# ============================

# PIN inicial para GERENTE (4-6 digitos)
BARBACOA_GERENTE_PIN=

# PIN inicial para DUENIO (4-6 digitos)
BARBACOA_DUENIO_PIN=

# Vigencia del cache offline de auth (horas)
BARBACOA_AUTH_CACHE_TTL_HOURS=24

# ============================
# PRINTER CONFIGURATION
# ============================

# Ruta del dispositivo USB (ej. /dev/usb/lp0). Si se deja vacío, se intenta autodetectar.
BARBACOA_PRINTER_DEVICE=/dev/usb/lp0

# Cola de impresión CUPS (opcional). Si se define, se usa CUPS.
BARBACOA_PRINTER_NAME=

# Forzar uso de CUPS aunque no haya nombre de cola.
BARBACOA_PRINTER_USE_CUPS=false

# Imprimir automáticamente al guardar comanda.
BARBACOA_PRINTER_AUTOPRINT=false

# Ticket: vista previa y guardado en archivo.
BARBACOA_TICKET_PREVIEW=true
BARBACOA_TICKET_SAVE=true

# Codificación para la impresora (cp437/cp850 suelen funcionar en térmicas 58mm).
BARBACOA_PRINTER_ENCODING=cp437

# Líneas de avance al final (para dar margen al corte o desprendido).
BARBACOA_PRINTER_FEED=4

# Cortar ticket si la impresora tiene cortador.
BARBACOA_PRINTER_CUT=true
