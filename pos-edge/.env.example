# AutoNoma POS Lite — Variables de Entorno
# Copia este archivo como .env y rellena los valores

# ---- Supabase ----
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key

# ---- Entorno ----
APP_ENV=development

# ---- Tenant ----
TENANT_ID=uuid-del-tenant-aqui
TENANT_SLUG=mi-cafeteria

# ---- Seguridad ----
SECRET_KEY=CAMBIA-ESTO-POR-UN-SECRETO-LARGO-Y-ALEATORIO
PIN_CAJERO=1234
PIN_ADMIN=9999
JWT_TTL_HOURS=12
AUTH_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_MAX_ACTIVE_SESSIONS=2

# ---- CORS ----
# En producción local con Nginx reverse proxy: https://pos-lite.local y/o https://<IP_LOCAL_POS>
ALLOW_ORIGINS=http://localhost:5173,http://localhost:4173,https://pos-lite.local
